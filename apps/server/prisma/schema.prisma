generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  CREATOR
  LEARNER
}

enum RoadmapStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NodeProgressStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  NEEDS_REVISION
}

enum StudyPlanStatus {
  PLANNED
  IN_PROGRESS
  COMPLETED
  SKIPPED
}

enum StudySessionStatus {
  ACTIVE
  COMPLETED
}

enum RevisionItemStatus {
  DUE
  COMPLETED
  SNOOZED
  ARCHIVED
}

enum DoubtStatus {
  OPEN
  RESOLVED
  FLAGGED
  HIDDEN
  CLOSED
}

enum DoubtReportStatus {
  PENDING
  REVIEWED
  DISMISSED
  ACTIONED
}

enum TopicStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PUBLISHED
  FLAGGED
}

enum CourseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  PUBLISHED
  FLAGGED
}

enum ReviewableContentType {
  COURSE
  TOPIC_PAGE
}

enum FlashcardReviewGrade {
  EASY
  GOOD
  HARD
  FORGOT
}

enum ContentBlockType {
  HEADING
  PARAGRAPH
  EXAMPLE
  REAL_WORLD_EXAMPLE
  COMMON_MISTAKE
  WARNING
  TIP
  CODE
  QUIZ_REFERENCE
  VIDEO_REFERENCE
}

enum QuizQuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
}

model User {
  id              String                @id @default(cuid())
  email           String                @unique
  name            String?
  passwordHash    String
  role            Role                  @default(LEARNER)
  refreshTokens   RefreshToken[]
  createdRoadmaps Roadmap[]             @relation("RoadmapCreator")
  createdTopics   TopicPage[]           @relation("TopicCreator")
  approvedTopics  TopicPage[]           @relation("TopicApprover")
  createdCourses  Course[]              @relation("CourseCreator")
  approvedCourses Course[]              @relation("CourseApprover")
  reviewEvents    ContentReviewEvent[]  @relation("ReviewEventActor")
  roadmapProgress UserRoadmapProgress[]
  nodeProgress    UserNodeProgress[]
  quizAttempts    QuizAttempt[]
  studyPlans      StudyPlan[]
  studySessions   StudySession[]
  revisionItems   RevisionItem[]
  flashcards      Flashcard[]
  flashcardReviews FlashcardReview[]
  learnerStats    LearnerStats?
  profile         UserProfile?
  following       UserFollow[]          @relation("UserFollowing")
  followers       UserFollow[]          @relation("UserFollowers")
  doubts          Doubt[]               @relation("DoubtAuthor")
  doubtReplies    DoubtReply[]          @relation("DoubtReplyAuthor")
  officialReplies DoubtReply[]          @relation("OfficialDoubtReplyMarker")
  doubtVotes      DoubtVote[]
  doubtReports    DoubtReport[]         @relation("DoubtReportReporter")
  reviewedReports DoubtReport[]         @relation("DoubtReportReviewer")
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
}


model UserProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  headline  String?
  bio       String?
  location  String?
  website   String?
  avatarUrl String?
  skills    String[] @default([])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserFollow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  follower    User     @relation("UserFollowing", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("UserFollowers", fields: [followingId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, followingId])
  @@index([followingId])
  @@index([followerId])
}

model RefreshToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model Roadmap {
  id              String                @id @default(cuid())
  title           String
  slug            String                @unique
  description     String?
  status          RoadmapStatus         @default(DRAFT)
  createdById     String
  createdBy       User                  @relation("RoadmapCreator", fields: [createdById], references: [id])
  nodes           RoadmapNode[]
  learnerProgress UserRoadmapProgress[]
  studyPlans      StudyPlan[]
  studySessions   StudySession[]
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([status])
  @@index([createdById])
}

model RoadmapNode {
  id            String             @id @default(cuid())
  roadmapId     String
  roadmap       Roadmap            @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  title         String
  slug          String
  summary       String?
  content       String?
  order         Int                @default(0)
  topicPages    TopicPage[]
  flashcards    Flashcard[]
  prerequisites RoadmapNode[]      @relation("NodePrerequisites")
  unlocks       RoadmapNode[]      @relation("NodePrerequisites")
  userProgress  UserNodeProgress[]
  studyPlans    StudyPlan[]
  studySessions StudySession[]
  revisionItems RevisionItem[]
  doubts        Doubt[]
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([roadmapId, slug])
  @@index([roadmapId, order])
}

model UserRoadmapProgress {
  id             String             @id @default(cuid())
  userId         String
  user           User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmapId      String
  roadmap        Roadmap            @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  startedAt      DateTime           @default(now())
  completedAt    DateTime?
  lastAccessedAt DateTime           @default(now())
  nodeProgress   UserNodeProgress[]
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([userId, roadmapId])
  @@index([roadmapId])
}

model UserNodeProgress {
  id                    String              @id @default(cuid())
  userId                String
  user                  User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmapNodeId         String
  roadmapNode           RoadmapNode         @relation(fields: [roadmapNodeId], references: [id], onDelete: Cascade)
  userRoadmapProgressId String
  userRoadmapProgress   UserRoadmapProgress @relation(fields: [userRoadmapProgressId], references: [id], onDelete: Cascade)
  status                NodeProgressStatus  @default(NOT_STARTED)
  startedAt             DateTime?
  completedAt           DateTime?
  needsRevisionAt       DateTime?
  createdAt             DateTime            @default(now())
  updatedAt             DateTime            @updatedAt

  @@unique([userId, roadmapNodeId])
  @@index([userRoadmapProgressId])
  @@index([status])
}

model TopicPage {
  id            String               @id @default(cuid())
  title         String
  slug          String               @unique
  summary       String?
  status        TopicStatus          @default(DRAFT)
  roadmapNodeId String?
  roadmapNode   RoadmapNode?         @relation(fields: [roadmapNodeId], references: [id], onDelete: SetNull)
  createdById   String
  createdBy     User                 @relation("TopicCreator", fields: [createdById], references: [id])
  approvedById  String?
  approvedBy    User?                @relation("TopicApprover", fields: [approvedById], references: [id])
  reviewNotes   String?
  submittedAt   DateTime?
  approvedAt    DateTime?
  publishedAt   DateTime?
  blocks        ContentBlock[]
  lessons       Lesson[]
  quizzes       TopicPageQuiz[]
  studySessions StudySession[]
  revisionItems RevisionItem[]
  flashcards    Flashcard[]
  doubts        Doubt[]
  reviewEvents  ContentReviewEvent[]
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@index([status])
  @@index([roadmapNodeId])
  @@index([createdById])
}

model Flashcard {
  id               String               @id @default(cuid())
  userId           String
  user             User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  topicPageId      String?
  topicPage        TopicPage?           @relation(fields: [topicPageId], references: [id], onDelete: Cascade)
  roadmapNodeId    String?
  roadmapNode      RoadmapNode?         @relation(fields: [roadmapNodeId], references: [id], onDelete: Cascade)
  frontText        String
  backText         String
  reviewCount      Int                  @default(0)
  reviewValueTotal Int                  @default(0)
  intervalDays     Int                  @default(1)
  nextReviewAt     DateTime
  masteryScore     Int                  @default(0)
  reviews          FlashcardReview[]
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([userId])
  @@index([nextReviewAt])
  @@index([topicPageId])
}

model FlashcardReview {
  id           String               @id @default(cuid())
  flashcardId  String
  flashcard    Flashcard            @relation(fields: [flashcardId], references: [id], onDelete: Cascade)
  userId       String
  user         User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  grade        FlashcardReviewGrade
  intervalDays Int
  nextReviewAt DateTime
  createdAt    DateTime             @default(now())

  @@index([flashcardId])
}

model ContentBlock {
  id          String           @id @default(cuid())
  topicPageId String
  topicPage   TopicPage        @relation(fields: [topicPageId], references: [id], onDelete: Cascade)
  type        ContentBlockType
  title       String?
  content     String
  language    String?
  referenceId String?
  order       Int              @default(0)
  metadata    Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([topicPageId, order])
  @@index([type])
}

model Course {
  id           String               @id @default(cuid())
  title        String
  slug         String               @unique
  subtitle     String?
  description  String?
  level        String?
  status       CourseStatus         @default(DRAFT)
  reviewNotes  String?
  submittedAt  DateTime?
  approvedAt   DateTime?
  publishedAt  DateTime?
  createdById  String
  createdBy    User                 @relation("CourseCreator", fields: [createdById], references: [id])
  approvedById String?
  approvedBy   User?                @relation("CourseApprover", fields: [approvedById], references: [id])
  modules      CourseModule[]
  reviewEvents ContentReviewEvent[]
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@index([status])
  @@index([createdById])
}

model CourseModule {
  id        String   @id @default(cuid())
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  title     String
  slug      String
  summary   String?
  order     Int      @default(0)
  lessons   Lesson[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([courseId, slug])
  @@index([courseId, order])
}

model Lesson {
  id          String               @id @default(cuid())
  moduleId    String
  module      CourseModule         @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  title       String
  slug        String
  summary     String?
  videoUrl    String?
  order       Int                  @default(0)
  topicPageId String?
  topicPage   TopicPage?           @relation(fields: [topicPageId], references: [id], onDelete: SetNull)
  notes       LessonContentBlock[]
  quiz        Quiz?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@unique([moduleId, slug])
  @@index([moduleId, order])
  @@index([topicPageId])
}

model TopicPageQuiz {
  id          String    @id @default(cuid())
  topicPageId String
  topicPage   TopicPage @relation(fields: [topicPageId], references: [id], onDelete: Cascade)
  quiz        Quiz      @relation(fields: [quizId], references: [id], onDelete: Cascade)
  quizId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([topicPageId, quizId])
}

model LessonContentBlock {
  id          String           @id @default(cuid())
  lessonId    String
  lesson      Lesson           @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  type        ContentBlockType
  title       String?
  content     String
  language    String?
  referenceId String?
  order       Int              @default(0)
  metadata    Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([lessonId, order])
  @@index([type])
}

model Quiz {
  id           String          @id @default(cuid())
  lessonId     String?         @unique
  lesson       Lesson?         @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  title        String
  instructions String?
  passingScore Int             @default(70)
  questions    QuizQuestion[]
  topicPages   TopicPageQuiz[]
  attempts     QuizAttempt[]
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([lessonId])
}

model QuizQuestion {
  id            String           @id @default(cuid())
  quizId        String
  quiz          Quiz             @relation(fields: [quizId], references: [id], onDelete: Cascade)
  prompt        String
  type          QuizQuestionType @default(MULTIPLE_CHOICE)
  options       Json?
  correctAnswer String
  explanation   String?
  order         Int              @default(0)
  answers       QuizAnswer[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  @@index([quizId, order])
}

model QuizAttempt {
  id               String       @id @default(cuid())
  quizId           String
  quiz             Quiz         @relation(fields: [quizId], references: [id], onDelete: Cascade)
  userId           String
  user             User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  score            Int
  totalQuestions   Int
  timeTakenSeconds Int?
  answers          QuizAnswer[]
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  @@index([quizId, userId])
  @@index([userId, createdAt])
}

model QuizAnswer {
  id             String       @id @default(cuid())
  attemptId      String
  attempt        QuizAttempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId     String
  question       QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedAnswer String
  isCorrect      Boolean
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([attemptId, questionId])
  @@index([attemptId])
}

model StudyPlan {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmapId        String?
  roadmap          Roadmap?        @relation(fields: [roadmapId], references: [id], onDelete: SetNull)
  roadmapNodeId    String?
  roadmapNode      RoadmapNode?    @relation(fields: [roadmapNodeId], references: [id], onDelete: SetNull)
  title            String
  description      String?
  plannedDate      DateTime
  estimatedMinutes Int             @default(30)
  status           StudyPlanStatus @default(PLANNED)
  completedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([userId, plannedDate])
  @@index([userId, status])
  @@index([roadmapId])
  @@index([roadmapNodeId])
}

model StudySession {
  id              String             @id @default(cuid())
  userId          String
  user            User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmapId       String?
  roadmap         Roadmap?           @relation(fields: [roadmapId], references: [id], onDelete: SetNull)
  roadmapNodeId   String?
  roadmapNode     RoadmapNode?       @relation(fields: [roadmapNodeId], references: [id], onDelete: SetNull)
  topicPageId     String?
  topicPage       TopicPage?         @relation(fields: [topicPageId], references: [id], onDelete: SetNull)
  title           String?
  startedAt       DateTime           @default(now())
  endedAt         DateTime?
  durationMinutes Int?
  status          StudySessionStatus @default(ACTIVE)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@index([userId, startedAt])
  @@index([userId, status])
  @@index([roadmapId])
  @@index([roadmapNodeId])
  @@index([topicPageId])
}

model RevisionItem {
  id            String             @id @default(cuid())
  userId        String
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  roadmapNodeId String?
  roadmapNode   RoadmapNode?       @relation(fields: [roadmapNodeId], references: [id], onDelete: SetNull)
  topicPageId   String?
  topicPage     TopicPage?         @relation(fields: [topicPageId], references: [id], onDelete: SetNull)
  title         String
  reason        String?
  dueAt         DateTime
  confidence    Int                @default(50)
  intervalDays  Int                @default(1)
  status        RevisionItemStatus @default(DUE)
  completedAt   DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([userId, dueAt])
  @@index([userId, status])
  @@index([roadmapNodeId])
  @@index([topicPageId])
}

model LearnerStats {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  currentStreak     Int       @default(0)
  longestStreak     Int       @default(0)
  totalStudyMinutes Int       @default(0)
  lastStudiedAt     DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
}

model Doubt {
  id                    String        @id @default(cuid())
  title                 String
  content               String
  status                DoubtStatus   @default(OPEN)
  topicPageId           String?
  topicPage             TopicPage?    @relation(fields: [topicPageId], references: [id], onDelete: SetNull)
  roadmapNodeId         String?
  roadmapNode           RoadmapNode?  @relation(fields: [roadmapNodeId], references: [id], onDelete: SetNull)
  videoTimestampSeconds Int?
  authorId              String
  author                User          @relation("DoubtAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  acceptedReplyId       String?       @unique
  acceptedReply         DoubtReply?   @relation("AcceptedDoubtReply", fields: [acceptedReplyId], references: [id], onDelete: SetNull)
  moderationReason      String?
  moderatedAt           DateTime?
  replies               DoubtReply[]  @relation("DoubtReplies")
  votes                 DoubtVote[]
  reports               DoubtReport[]
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([topicPageId, createdAt])
  @@index([roadmapNodeId, createdAt])
  @@index([authorId, createdAt])
  @@index([status])
}

model DoubtReply {
  id                 String        @id @default(cuid())
  doubtId            String
  doubt              Doubt         @relation("DoubtReplies", fields: [doubtId], references: [id], onDelete: Cascade)
  authorId           String
  author             User          @relation("DoubtReplyAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  content            String
  isOfficial         Boolean       @default(false)
  officialMarkedById String?
  officialMarkedBy   User?         @relation("OfficialDoubtReplyMarker", fields: [officialMarkedById], references: [id], onDelete: SetNull)
  officialMarkedAt   DateTime?
  isHidden           Boolean       @default(false)
  moderationReason   String?
  moderatedAt        DateTime?
  acceptedFor        Doubt?        @relation("AcceptedDoubtReply")
  votes              DoubtVote[]
  reports            DoubtReport[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([doubtId, createdAt])
  @@index([authorId, createdAt])
  @@index([isOfficial])
  @@index([isHidden])
}

model DoubtVote {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  doubtId   String?
  doubt     Doubt?      @relation(fields: [doubtId], references: [id], onDelete: Cascade)
  replyId   String?
  reply     DoubtReply? @relation(fields: [replyId], references: [id], onDelete: Cascade)
  value     Int         @default(1)
  createdAt DateTime    @default(now())

  @@unique([userId, doubtId])
  @@unique([userId, replyId])
  @@index([doubtId])
  @@index([replyId])
}

model DoubtReport {
  id              String            @id @default(cuid())
  reporterId      String
  reporter        User              @relation("DoubtReportReporter", fields: [reporterId], references: [id], onDelete: Cascade)
  doubtId         String?
  doubt           Doubt?            @relation(fields: [doubtId], references: [id], onDelete: Cascade)
  replyId         String?
  reply           DoubtReply?       @relation(fields: [replyId], references: [id], onDelete: Cascade)
  reason          String
  status          DoubtReportStatus @default(PENDING)
  reviewedById    String?
  reviewedBy      User?             @relation("DoubtReportReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  reviewedAt      DateTime?
  resolutionNotes String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@unique([reporterId, doubtId])
  @@unique([reporterId, replyId])
  @@index([doubtId, createdAt])
  @@index([replyId, createdAt])
  @@index([status, createdAt])
}

model ContentReviewEvent {
  id          String                @id @default(cuid())
  contentType ReviewableContentType
  courseId    String?
  course      Course?               @relation(fields: [courseId], references: [id], onDelete: Cascade)
  topicPageId String?
  topicPage   TopicPage?            @relation(fields: [topicPageId], references: [id], onDelete: Cascade)
  fromStatus  String?
  toStatus    String
  reason      String?
  actorId     String
  actor       User                  @relation("ReviewEventActor", fields: [actorId], references: [id])
  metadata    Json?
  createdAt   DateTime              @default(now())

  @@index([contentType, createdAt])
  @@index([courseId, createdAt])
  @@index([topicPageId, createdAt])
  @@index([actorId])
}
