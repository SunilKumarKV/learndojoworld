# Application
NODE_ENV=development
APP_NAME=LearnDojoWorld
API_PORT=4000
WEB_ORIGIN="http://localhost:3000"
NEXT_PUBLIC_WEB_URL="http://localhost:3000"
NEXT_PUBLIC_API_URL="http://localhost:4000/api/v1"
# Comma-separated origins are supported for local/staging/prod allowlists.
# Do not use "*" in production.

# Database
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/learndojoworld?schema=public"

# Cache
# Required by current API env validation. Use a managed Redis URL in production if Redis-backed
# features or distributed rate limiting are enabled.
REDIS_URL="redis://localhost:6379"

# Security
JWT_SECRET="replace-with-a-long-random-secret"
JWT_REFRESH_SECRET="replace-with-a-long-random-refresh-secret"

# AI provider (optional)
# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Gemini (Google)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Provider selection
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_PROVIDER=openai

# Payments
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Observability
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0
LOG_LEVEL=info
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_ENVIRONMENT=development
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0

# Rate limiting
# Current defaults are code-configured:
# global API default = 120 req/min, login/register = 5 req/min, AI chat = 30 req/min.
# Add Redis/distributed throttling before horizontally scaling API instances.
