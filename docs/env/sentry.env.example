# Sentry Environment Reference
# Placeholders only. Configure API values in Render and web values in Vercel.

# API project
SENTRY_DSN=https://your-api-dsn@o000000.ingest.sentry.io/000000
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05

# Web project browser and server runtime
SENTRY_DSN=https://your-web-server-dsn@o000000.ingest.sentry.io/000000
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05
NEXT_PUBLIC_SENTRY_DSN=https://your-public-web-dsn@o000000.ingest.sentry.io/000000
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05

# Keep Sentry auth tokens out of the repository.
