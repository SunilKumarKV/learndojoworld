# Neon Postgres Reference
# Placeholders only. Store the actual connection string in Render as DATABASE_URL.

NEON_PROJECT_NAME=learndojoworld-production
NEON_DATABASE_NAME=learndojoworld
NEON_REGION=closest-supported-region

# Use the SSL-enabled connection string provided by Neon.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/learndojoworld?sslmode=require&schema=public

