# Render API Environment
# Placeholders only. Configure these in Render service environment settings.

NODE_ENV=production
APP_NAME=LearnDojoWorld
API_PORT=4000
WEB_ORIGIN=https://your-domain.com

# Neon Postgres
DATABASE_URL=postgresql://USER:PASSWORD@HOST/learndojoworld?sslmode=require&schema=public

# Upstash Redis
REDIS_URL=redis://default:PASSWORD@HOST:6379

# Auth
JWT_SECRET=replace-with-long-random-access-token-secret
JWT_REFRESH_SECRET=replace-with-long-random-refresh-token-secret

# AI provider routing
AI_PRIMARY_PROVIDER=gemini
AI_FALLBACK_PROVIDER=openai
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=replace-with-openai-api-key-if-enabled
OPENAI_MODEL=gpt-4o-mini

# Payments
STRIPE_SECRET_KEY=sk_live_replace_with_stripe_secret
STRIPE_WEBHOOK_SECRET=whsec_replace_with_stripe_webhook_secret
RAZORPAY_KEY_ID=rzp_live_replace_with_razorpay_key_id
RAZORPAY_KEY_SECRET=replace-with-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=replace-with-razorpay-webhook-secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_replace_with_razorpay_key_id

# Observability
SENTRY_DSN=https://your-api-dsn@o000000.ingest.sentry.io/000000
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05
LOG_LEVEL=info
