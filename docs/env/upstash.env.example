# Upstash Redis Reference
# Placeholders only. Store the actual Redis URL in Render as REDIS_URL.

UPSTASH_DATABASE_NAME=learndojoworld-production
UPSTASH_REGION=closest-supported-region
REDIS_URL=redis://default:PASSWORD@HOST:6379

# Current API env validation requires REDIS_URL.
# Use Redis-backed/distributed throttling before horizontally scaling API instances.
