# Vercel Web Environment
# Placeholders only. Configure these in Vercel Project Settings.

NODE_ENV=production
NEXT_PUBLIC_WEB_URL=https://your-domain.com
NEXT_PUBLIC_API_URL=https://api.your-domain.com/api/v1

# Public payment key used by browser checkout when Razorpay is enabled.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_your_key_id

# Optional Sentry monitoring.
SENTRY_DSN=https://your-web-server-dsn@o000000.ingest.sentry.io/000000
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.05
NEXT_PUBLIC_SENTRY_DSN=https://your-public-web-dsn@o000000.ingest.sentry.io/000000
NEXT_PUBLIC_SENTRY_ENVIRONMENT=production
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.05
